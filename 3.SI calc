 package com.example.simpleinterest;
 
import android.content.DialogInterface;
import android.os.Bundle;
import android.view.View;
import android.widget.Button;
import android.widget.TextView;
import android.widget.Toast;
import androidx.appcompat.app.AlertDialog;
import androidx.appcompat.app.AppCompatActivity;
 
public class ResultActivity extends AppCompatActivity {
 
    TextView tvResult;
    Button   btnClear;
 
    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_result);
 
        tvResult = findViewById(R.id.tvResult);
        btnClear = findViewById(R.id.btnClear);
 
        // Receive values from MainActivity
        double principal = getIntent().getDoubleExtra("principal", 0);
        double rate      = getIntent().getDoubleExtra("rate", 0);
        double time      = getIntent().getDoubleExtra("time", 0);
 
        // Formula: SI = (P x R x T) / 100
        double si = (principal * rate * time) / 100;
 
        // Show result in TextView
        tvResult.setText("Simple Interest: Rs." + String.format("%.2f", si));
 
        // Show Toast
        Toast.makeText(this,
                "Interest Calculated: Rs." + String.format("%.2f", si),
                Toast.LENGTH_LONG).show();
 
        // Clear button
        btnClear.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
 
                // Clear the TextView
                tvResult.setText("Simple Interest: ");
 
                // Show AlertDialog
                new AlertDialog.Builder(ResultActivity.this)
                        .setTitle("Cleared")
                        .setMessage("All fields cleared.")
                        .setPositiveButton("OK", new DialogInterface.OnClickListener() {
                            @Override
                            public void onClick(DialogInterface dialog, int which) {
                                dialog.dismiss();
                            }
                        })
                        .show();
            }
        });
    }
}

