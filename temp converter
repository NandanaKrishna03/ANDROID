<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">
 
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Temperature Converter"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>
 
    <EditText
        android:id="@+id/etTemp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Temperature"
        android:inputType="numberDecimal|numberSigned"
        android:layout_marginBottom="20dp"/>
 
    <!-- RadioGroup for conversion direction -->
    <RadioGroup
        android:id="@+id/rgConversion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp">
 
        <RadioButton
            android:id="@+id/rbCtoF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Celsius to Fahrenheit"
            android:checked="true"/>
 
        <RadioButton
            android:id="@+id/rbFtoC"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fahrenheit to Celsius"/>
 
    </RadioGroup>
 
    <Button
        android:id="@+id/btnConvert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Convert"/>
 
</LinearLayout>


main.java
package com.example.tempconverter;

import android.content.Intent;
import android.os.Bundle;
import android.view.View;
import android.widget.Button;
import android.widget.EditText;
import android.widget.RadioGroup;
import android.widget.Toast;
import androidx.appcompat.app.AppCompatActivity;

public class MainActivity extends AppCompatActivity {

    EditText  etTemp;
    RadioGroup rgConversion;
    Button    btnConvert;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        etTemp        = findViewById(R.id.etTemp);
        rgConversion  = findViewById(R.id.rgConversion);
        btnConvert    = findViewById(R.id.btnConvert);

        btnConvert.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                String input = etTemp.getText().toString().trim();
                if (input.isEmpty()) {
                    Toast.makeText(MainActivity.this,
                            "Enter a temperature value", Toast.LENGTH_SHORT).show();
                    return;
                }

                double temp = Double.parseDouble(input);
                boolean isCtoF = (rgConversion.getCheckedRadioButtonId() == R.id.rbCtoF);

                Intent intent = new Intent(MainActivity.this, ResultActivity.class);
                intent.putExtra("temp", temp);
                intent.putExtra("isCtoF", isCtoF);
                startActivity(intent);
            }
        }); 
    }
}



