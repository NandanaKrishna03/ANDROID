<?xml version="1.0" encoding="utf-8"?>
<!-- activity_home.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- Shows username received from LoginActivity -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"/>

    <!-- Scenario 2: Open Google in Browser -->
    <Button
        android:id="@+id/btnGoogle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Google (Implicit Intent)"
        android:layout_marginBottom="16dp"/>

    <!-- Scenario 3: Open Dialer -->
    <Button
        android:id="@+id/btnDial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Dialer (ACTION_DIAL)"
        android:layout_marginBottom="16dp"/>

    <!-- Scenario 4: Pass age to AgeActivity -->
    <Button
        android:id="@+id/btnAge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pass Age to Next Activity"/>

</LinearLayout>

