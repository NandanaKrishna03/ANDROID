package com.example.arithmetic;

import android.os.Bundle;
import android.widget.TextView;
import androidx.appcompat.app.AppCompatActivity;

public class ResultActivity extends AppCompatActivity {

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_result);

        double n1 = getIntent().getDoubleExtra("num1", 0);
        double n2 = getIntent().getDoubleExtra("num2", 0);

        ((TextView) findViewById(R.id.tvAdd)).setText("Addition:       " + (n1 + n2));
        ((TextView) findViewById(R.id.tvSub)).setText("Subtraction:    " + (n1 - n2));
        ((TextView) findViewById(R.id.tvMul)).setText("Multiplication: " + (n1 * n2));
        ((TextView) findViewById(R.id.tvDiv)).setText("Division:       "
                + (n2 != 0 ? String.format("%.4f", n1 / n2) : "Undefined (÷0)"));
        ((TextView) findViewById(R.id.tvMod)).setText("Modulus:        "
                + (n2 != 0 ? (n1 % n2) : "Undefined (÷0)"));
    }
}
 
