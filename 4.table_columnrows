<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="*">

        <!-- Row 1 -->
        <TableRow>

            <Button
                android:id="@+id/btnRow1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_span="3"
                android:text="Row1"/>
        </TableRow>

        <!-- Row 2 -->
        <TableRow
            android:layout_marginTop="15dp">

            <Button
                android:id="@+id/btnRow2Col1"
                android:text="Row2 Col1"/>

            <Button
                android:id="@+id/btnRow2Col2"
                android:layout_span="2"
                android:text="Row2 Col2"/>
        </TableRow>

        <!-- Row 3 -->
        <TableRow
            android:layout_marginTop="15dp">

            <Button
                android:id="@+id/btnRow3Col1"
                android:text="Row3 Col1"/>

            <Button
                android:id="@+id/btnRow3Col2"
                android:text="Row3 Col2"/>

            <Button
                android:id="@+id/btnRow3Col3"
                android:text="Row3 Col3"/>
        </TableRow>

        <!-- Row 4 -->
        <TableRow
            android:layout_marginTop="15dp">

            <Button
                android:id="@+id/btnRow4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_span="3"
                android:text="Row4"/>
        </TableRow>

    </TableLayout>

</LinearLayout>

MainActivity.java
package com.example.table_layout_sem;

import android.os.Bundle;
import android.view.View;
import android.widget.Button;
import android.widget.Toast;

import androidx.activity.EdgeToEdge;
import androidx.appcompat.app.AppCompatActivity;
import androidx.core.graphics.Insets;
import androidx.core.view.ViewCompat;
import androidx.core.view.WindowInsetsCompat;

public class MainActivity extends AppCompatActivity {

    Button btnRow1, btnRow2Col1, btnRow2Col2, btnRow3Col1, btnRow3Col2, btnRow3Col3, btnRow4;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        EdgeToEdge.enable(this);
        setContentView(R.layout.activity_main);
        btnRow1 = findViewById(R.id.btnRow1);
        btnRow2Col1 = findViewById(R.id.btnRow2Col1);
        btnRow2Col2 = findViewById(R.id.btnRow2Col2);
        btnRow3Col1 = findViewById(R.id.btnRow3Col1);
        btnRow3Col2 = findViewById(R.id.btnRow3Col2);
        btnRow3Col3 = findViewById(R.id.btnRow3Col3);
        btnRow4 = findViewById(R.id.btnRow4);

        btnRow1.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                Toast.makeText(MainActivity.this, "Row1 Selected", Toast.LENGTH_SHORT).show();
            }
        });

        btnRow2Col1.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                Toast.makeText(MainActivity.this, "Row2Col1 Selected", Toast.LENGTH_SHORT).show();
            }
        });
        btnRow2Col2.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                Toast.makeText(MainActivity.this, "Row2Col2 Selected", Toast.LENGTH_SHORT).show();
            }
        });
        btnRow3Col1.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                Toast.makeText(MainActivity.this, "Row2Col1 Selected", Toast.LENGTH_SHORT).show();
            }
        });
        btnRow3Col2.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                Toast.makeText(MainActivity.this, "Row3Col2 Selected", Toast.LENGTH_SHORT).show();
            }
        });
        btnRow3Col3.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                Toast.makeText(MainActivity.this, "Row3Col3 Selected", Toast.LENGTH_SHORT).show();
            }
        });
        btnRow4.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                Toast.makeText(MainActivity.this, "Row4 Selected", Toast.LENGTH_SHORT).show();
            }
        });

    }
}
